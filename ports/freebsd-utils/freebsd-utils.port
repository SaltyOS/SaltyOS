[port]
name = freebsd-utils
version = 14.2
description = FreeBSD userland utilities for SaltyOS
homepage = https://www.freebsd.org/
license = BSD-2-Clause

[source]
url = https://github.com/freebsd/freebsd-src/archive/refs/tags/release/${version}.0.tar.gz
subdir = freebsd-src-release-${version}.0
sha256 = SKIP

[build]
type = targets

[depends]
build = zlib, bzip2, xz, zstd, openssl, ncurses

[env]
EXTRA_CFLAGS = -Wno-unused-parameter -Wno-sign-compare -Wno-missing-field-initializers -Wno-missing-braces -Wno-gnu-designator -Wno-#warnings -Wno-macro-redefined -D__FreeBSD_version=1402000 -DBOOTSTRAP_CAT -DNO_UDOM_SUPPORT -DWITHOUT_NLS
EXTRA_LIBS = -L${PORTDIR}/../zlib/${ARCH_STAGE} -L${PORTDIR}/../bzip2/${ARCH_STAGE} -L${PORTDIR}/../xz/${ARCH_STAGE} -L${PORTDIR}/../zstd/${ARCH_STAGE} -L${PORTDIR}/../openssl/${ARCH_STAGE} -lz -lbz2 -llzma -lzstd

[libs]
archive = contrib/libarchive/libarchive/*.c :: -Icontrib/libarchive/libarchive -DPLATFORM_CONFIG_H=\"${PORTDIR}/config_saltyos_libarchive.h\" -I${PORTDIR}/../zlib/${ARCH_WORK}/zlib-1.3.1 -I${PORTDIR}/../zlib/${ARCH_WORK}/zlib-1.3.1/_build -I${PORTDIR}/../bzip2/${ARCH_WORK}/bzip2-1.0.8 -I${PORTDIR}/../xz/${ARCH_WORK}/xz-5.6.3/src/liblzma/api -I${PORTDIR}/../zstd/${ARCH_WORK}/zstd-1.5.6/lib
fetch = lib/libfetch/common.c lib/libfetch/fetch.c lib/libfetch/file.c lib/libfetch/ftp.c lib/libfetch/http.c :: -Ilib/libfetch -DWITH_SSL -DOPENSSL_API_COMPAT=0x10100000L -DINET -I${PORTDIR}/../openssl/${ARCH_WORK}/openssl-3.4.1/include

[targets.cflags]
-I${SRCDIR} -I${SRCDIR}/include -I${SRCDIR}/lib/libc/include
-I${SRCDIR}/sys -I${SRCDIR}/sys/${MACHINE_INCLUDE}
-I${SRCDIR}/contrib -include sys/cdefs.h

[targets]
echo     = bin/echo/echo.c
cat      = bin/cat/cat.c :: -DBOOTSTRAP_CAT
ls       = bin/ls/ls.c bin/ls/cmp.c bin/ls/print.c bin/ls/util.c :: -Ibin/ls
cp       = bin/cp/cp.c bin/cp/utils.c :: -Ibin/cp
mv       = bin/mv/mv.c
rm       = bin/rm/rm.c
mkdir    = bin/mkdir/mkdir.c
rmdir    = bin/rmdir/rmdir.c
ln       = bin/ln/ln.c
chmod    = bin/chmod/chmod.c
test     = bin/test/test.c
sleep    = bin/sleep/sleep.c
pwd      = bin/pwd/pwd.c
head     = usr.bin/head/head.c
tail     = usr.bin/tail/tail.c usr.bin/tail/forward.c usr.bin/tail/misc.c usr.bin/tail/read.c usr.bin/tail/reverse.c :: -Iusr.bin/tail
wc       = usr.bin/wc/wc.c
sort     = usr.bin/sort/sort.c usr.bin/sort/bwstring.c usr.bin/sort/coll.c usr.bin/sort/file.c usr.bin/sort/mem.c usr.bin/sort/radixsort.c :: -Iusr.bin/sort
uniq     = usr.bin/uniq/uniq.c
basename = usr.bin/basename/basename.c
dirname  = usr.bin/dirname/dirname.c
env      = usr.bin/env/env.c
tee      = usr.bin/tee/tee.c
id       = usr.bin/id/id.c
uname    = usr.bin/uname/uname.c
true     = usr.bin/true/true.c
false    = usr.bin/false/false.c
grep     = usr.bin/grep/file.c usr.bin/grep/grep.c usr.bin/grep/queue.c usr.bin/grep/util.c :: -Iusr.bin/grep
xargs    = usr.bin/xargs/xargs.c usr.bin/xargs/strnsubst.c :: -Iusr.bin/xargs
kill     = bin/kill/kill.c
stat     = usr.bin/stat/stat.c :: -DHAVE_STRUCT_STAT_ST_FLAGS=0 -DHAVE_STRUCT_STAT_ST_BIRTHTIME=0
tr       = usr.bin/tr/cmap.c usr.bin/tr/cset.c usr.bin/tr/str.c usr.bin/tr/tr.c :: -Iusr.bin/tr
cut      = usr.bin/cut/cut.c
touch    = usr.bin/touch/touch.c
date     = bin/date/date.c bin/date/vary.c :: -Ibin/date
find     = usr.bin/find/find.c usr.bin/find/function.c usr.bin/find/ls.c usr.bin/find/main.c usr.bin/find/misc.c usr.bin/find/operator.c usr.bin/find/option.c :: -Iusr.bin/find
sed      = usr.bin/sed/compile.c usr.bin/sed/main.c usr.bin/sed/misc.c usr.bin/sed/process.c :: -Iusr.bin/sed
awk      = contrib/one-true-awk/b.c contrib/one-true-awk/lex.c contrib/one-true-awk/lib.c contrib/one-true-awk/main.c contrib/one-true-awk/parse.c contrib/one-true-awk/proctab.c contrib/one-true-awk/run.c contrib/one-true-awk/tran.c contrib/one-true-awk/awkgram.tab.c :: -Icontrib/one-true-awk -DHAS_ISBLANK -DFOPEN_MAX=64
diff     = usr.bin/diff/diff.c usr.bin/diff/diffdir.c usr.bin/diff/diffreg.c usr.bin/diff/xmalloc.c usr.bin/diff/pr.c :: -Iusr.bin/diff -include unistd.h
patch    = usr.bin/patch/backupfile.c usr.bin/patch/inp.c usr.bin/patch/mkpath.c usr.bin/patch/patch.c usr.bin/patch/pch.c usr.bin/patch/util.c :: -Iusr.bin/patch
gzip     = usr.bin/gzip/gzip.c :: -Iusr.bin/gzip -I${PORTDIR}/../zlib/${ARCH_WORK}/zlib-1.3.1 -I${PORTDIR}/../zlib/${ARCH_WORK}/zlib-1.3.1/_build -I${PORTDIR}/../bzip2/${ARCH_WORK}/bzip2-1.0.8 -I${PORTDIR}/../xz/${ARCH_WORK}/xz-5.6.3/src/liblzma/api -I${PORTDIR}/../zstd/${ARCH_WORK}/zstd-1.5.6/lib
m4       = usr.bin/m4/eval.c usr.bin/m4/expr.c usr.bin/m4/gnum4.c usr.bin/m4/look.c usr.bin/m4/main.c usr.bin/m4/misc.c usr.bin/m4/trace.c usr.bin/m4/parser.c usr.bin/m4/tokenizer.c lib/libopenbsd/ohash.c :: -Iusr.bin/m4 -Ilib/libopenbsd -DEXTENDED -include stdlib.h -include unistd.h
tar      = contrib/libarchive/tar/bsdtar.c contrib/libarchive/tar/cmdline.c contrib/libarchive/tar/creation_set.c contrib/libarchive/tar/read.c contrib/libarchive/tar/subst.c contrib/libarchive/tar/util.c contrib/libarchive/tar/write.c contrib/libarchive/libarchive_fe/err.c contrib/libarchive/libarchive_fe/line_reader.c contrib/libarchive/libarchive_fe/passphrase.c :: -Icontrib/libarchive/tar -Icontrib/libarchive/libarchive -Icontrib/libarchive/libarchive_fe -DPLATFORM_CONFIG_H=\"${PORTDIR}/config_saltyos_libarchive.h\" -DBSDTAR_VERSION_STRING=\"3.7.4\" -larchive
ping     = sbin/ping/main.c sbin/ping/ping.c sbin/ping/utils.c :: -Isbin/ping -DINET -include unistd.h
fetch    = usr.bin/fetch/fetch.c :: -Iusr.bin/fetch -Ilib/libfetch -DWITH_SSL -DOPENSSL_API_COMPAT=0x10100000L -I${PORTDIR}/../openssl/${ARCH_WORK}/openssl-3.4.1/include -lfetch -lssl -lcrypto
libutil.so = lib/libutil/auth.c lib/libutil/flopen.c lib/libutil/pw_util.c lib/libutil/stub.c lib/libc/gen/pw_scan.c :: -shared -fPIC -Wl,-soname,libutil.so -Ilib/libutil -Ilib/libc/gen
libpam.so = contrib/openpam/lib/libpam/openpam_asprintf.c contrib/openpam/lib/libpam/openpam_borrow_cred.c contrib/openpam/lib/libpam/openpam_check_owner_perms.c contrib/openpam/lib/libpam/openpam_configure.c contrib/openpam/lib/libpam/openpam_constants.c contrib/openpam/lib/libpam/openpam_dispatch.c contrib/openpam/lib/libpam/openpam_dynamic.c contrib/openpam/lib/libpam/openpam_features.c contrib/openpam/lib/libpam/openpam_findenv.c contrib/openpam/lib/libpam/openpam_free_data.c contrib/openpam/lib/libpam/openpam_free_envlist.c contrib/openpam/lib/libpam/openpam_get_feature.c contrib/openpam/lib/libpam/openpam_get_option.c contrib/openpam/lib/libpam/openpam_load.c contrib/openpam/lib/libpam/openpam_log.c contrib/openpam/lib/libpam/openpam_nullconv.c contrib/openpam/lib/libpam/openpam_readline.c contrib/openpam/lib/libpam/openpam_readlinev.c contrib/openpam/lib/libpam/openpam_readword.c contrib/openpam/lib/libpam/openpam_restore_cred.c contrib/openpam/lib/libpam/openpam_set_feature.c contrib/openpam/lib/libpam/openpam_set_option.c contrib/openpam/lib/libpam/openpam_straddch.c contrib/openpam/lib/libpam/openpam_strlcat.c contrib/openpam/lib/libpam/openpam_strlcpy.c contrib/openpam/lib/libpam/openpam_strlset.c contrib/openpam/lib/libpam/openpam_subst.c contrib/openpam/lib/libpam/openpam_ttyconv.c contrib/openpam/lib/libpam/openpam_vasprintf.c contrib/openpam/lib/libpam/pam_acct_mgmt.c contrib/openpam/lib/libpam/pam_authenticate.c contrib/openpam/lib/libpam/pam_chauthtok.c contrib/openpam/lib/libpam/pam_close_session.c contrib/openpam/lib/libpam/pam_end.c contrib/openpam/lib/libpam/pam_error.c contrib/openpam/lib/libpam/pam_get_authtok.c contrib/openpam/lib/libpam/pam_get_data.c contrib/openpam/lib/libpam/pam_get_item.c contrib/openpam/lib/libpam/pam_get_user.c contrib/openpam/lib/libpam/pam_getenv.c contrib/openpam/lib/libpam/pam_getenvlist.c contrib/openpam/lib/libpam/pam_info.c contrib/openpam/lib/libpam/pam_open_session.c contrib/openpam/lib/libpam/pam_prompt.c contrib/openpam/lib/libpam/pam_putenv.c contrib/openpam/lib/libpam/pam_set_data.c contrib/openpam/lib/libpam/pam_set_item.c contrib/openpam/lib/libpam/pam_setcred.c contrib/openpam/lib/libpam/pam_setenv.c contrib/openpam/lib/libpam/pam_start.c contrib/openpam/lib/libpam/pam_strerror.c contrib/openpam/lib/libpam/pam_verror.c contrib/openpam/lib/libpam/pam_vinfo.c contrib/openpam/lib/libpam/pam_vprompt.c :: -shared -fPIC -Wl,-soname,libpam.so -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules -Ilib/libpam/modules/pam_login_access -Ilib/libpam/modules/pam_xdg
pam/pam_deny.so = lib/libpam/modules/pam_deny/pam_deny.c :: -shared -fPIC -Wl,-soname,pam_deny.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules
pam/pam_echo.so = lib/libpam/modules/pam_echo/pam_echo.c :: -shared -fPIC -Wl,-soname,pam_echo.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules
pam/pam_ftpusers.so = lib/libpam/modules/pam_ftpusers/pam_ftpusers.c :: -shared -fPIC -Wl,-soname,pam_ftpusers.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules
pam/pam_group.so = lib/libpam/modules/pam_group/pam_group.c :: -shared -fPIC -Wl,-soname,pam_group.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules
pam/pam_guest.so = lib/libpam/modules/pam_guest/pam_guest.c :: -shared -fPIC -Wl,-soname,pam_guest.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules
pam/pam_login_access.so = lib/libpam/modules/pam_login_access/login_access.c lib/libpam/modules/pam_login_access/pam_login_access.c :: -shared -fPIC -Wl,-soname,pam_login_access.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules -Ilib/libpam/modules/pam_login_access
pam/pam_nologin.so = lib/libpam/modules/pam_nologin/pam_nologin.c :: -shared -fPIC -Wl,-soname,pam_nologin.so -L${SRCDIR}/_build -lpam -lutil -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules -Ilib/libutil
pam/pam_permit.so = lib/libpam/modules/pam_permit/pam_permit.c :: -shared -fPIC -Wl,-soname,pam_permit.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules
pam/pam_rootok.so = lib/libpam/modules/pam_rootok/pam_rootok.c :: -shared -fPIC -Wl,-soname,pam_rootok.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules
pam/pam_securetty.so = lib/libpam/modules/pam_securetty/pam_securetty.c :: -shared -fPIC -Wl,-soname,pam_securetty.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules
pam/pam_self.so = lib/libpam/modules/pam_self/pam_self.c :: -shared -fPIC -Wl,-soname,pam_self.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules
pam/pam_unix.so = lib/libpam/modules/pam_unix/pam_unix.c :: -shared -fPIC -Wl,-soname,pam_unix.so -L${SRCDIR}/_build -lpam -lutil -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules -Ilib/libutil -Ilib/libc/gen
pam/pam_xdg.so = lib/libpam/modules/pam_xdg/pam_xdg.c :: -shared -fPIC -Wl,-soname,pam_xdg.so -L${SRCDIR}/_build -lpam -DHAVE_CONFIG_H -Icontrib/openpam/include -Icontrib/openpam/lib/libpam -Ilib/libpam/modules -Ilib/libpam/modules/pam_xdg
su       = usr.bin/su/su.c :: -Iusr.bin/su -Ilib/libutil -include unistd.h -L${SRCDIR}/_build -lpam -lutil
vi       = contrib/nvi/cl/cl_funcs.c contrib/nvi/cl/cl_main.c contrib/nvi/cl/cl_read.c contrib/nvi/cl/cl_screen.c contrib/nvi/cl/cl_term.c contrib/nvi/common/conv.c contrib/nvi/common/cut.c contrib/nvi/common/delete.c contrib/nvi/common/encoding.c contrib/nvi/common/exf.c contrib/nvi/common/key.c contrib/nvi/common/line.c contrib/nvi/common/log.c contrib/nvi/common/main.c contrib/nvi/common/mark.c contrib/nvi/common/msg.c contrib/nvi/common/options.c contrib/nvi/common/options_f.c contrib/nvi/common/put.c contrib/nvi/common/recover.c contrib/nvi/common/screen.c contrib/nvi/common/search.c contrib/nvi/common/seq.c contrib/nvi/common/util.c contrib/nvi/ex/ex.c contrib/nvi/ex/ex_abbrev.c contrib/nvi/ex/ex_append.c contrib/nvi/ex/ex_args.c contrib/nvi/ex/ex_argv.c contrib/nvi/ex/ex_at.c contrib/nvi/ex/ex_bang.c contrib/nvi/ex/ex_cd.c contrib/nvi/ex/ex_cmd.c contrib/nvi/ex/ex_cscope.c contrib/nvi/ex/ex_delete.c contrib/nvi/ex/ex_display.c contrib/nvi/ex/ex_edit.c contrib/nvi/ex/ex_equal.c contrib/nvi/ex/ex_file.c contrib/nvi/ex/ex_filter.c contrib/nvi/ex/ex_global.c contrib/nvi/ex/ex_init.c contrib/nvi/ex/ex_join.c contrib/nvi/ex/ex_map.c contrib/nvi/ex/ex_mark.c contrib/nvi/ex/ex_mkexrc.c contrib/nvi/ex/ex_move.c contrib/nvi/ex/ex_open.c contrib/nvi/ex/ex_preserve.c contrib/nvi/ex/ex_print.c contrib/nvi/ex/ex_put.c contrib/nvi/ex/ex_quit.c contrib/nvi/ex/ex_read.c contrib/nvi/ex/ex_screen.c contrib/nvi/ex/ex_script.c contrib/nvi/ex/ex_set.c contrib/nvi/ex/ex_shell.c contrib/nvi/ex/ex_shift.c contrib/nvi/ex/ex_source.c contrib/nvi/ex/ex_stop.c contrib/nvi/ex/ex_subst.c contrib/nvi/ex/ex_tag.c contrib/nvi/ex/ex_txt.c contrib/nvi/ex/ex_undo.c contrib/nvi/ex/ex_usage.c contrib/nvi/ex/ex_util.c contrib/nvi/ex/ex_version.c contrib/nvi/ex/ex_visual.c contrib/nvi/ex/ex_write.c contrib/nvi/ex/ex_yank.c contrib/nvi/ex/ex_z.c contrib/nvi/vi/getc.c contrib/nvi/vi/v_at.c contrib/nvi/vi/v_ch.c contrib/nvi/vi/v_cmd.c contrib/nvi/vi/v_delete.c contrib/nvi/vi/v_ex.c contrib/nvi/vi/v_increment.c contrib/nvi/vi/v_init.c contrib/nvi/vi/v_itxt.c contrib/nvi/vi/v_left.c contrib/nvi/vi/v_mark.c contrib/nvi/vi/v_match.c contrib/nvi/vi/v_paragraph.c contrib/nvi/vi/v_put.c contrib/nvi/vi/v_redraw.c contrib/nvi/vi/v_replace.c contrib/nvi/vi/v_right.c contrib/nvi/vi/v_screen.c contrib/nvi/vi/v_scroll.c contrib/nvi/vi/v_search.c contrib/nvi/vi/v_section.c contrib/nvi/vi/v_sentence.c contrib/nvi/vi/v_status.c contrib/nvi/vi/v_txt.c contrib/nvi/vi/v_ulcase.c contrib/nvi/vi/v_undo.c contrib/nvi/vi/v_util.c contrib/nvi/vi/v_word.c contrib/nvi/vi/v_xchar.c contrib/nvi/vi/v_yank.c contrib/nvi/vi/v_z.c contrib/nvi/vi/v_zexit.c contrib/nvi/vi/vi.c contrib/nvi/vi/vs_line.c contrib/nvi/vi/vs_msg.c contrib/nvi/vi/vs_refresh.c contrib/nvi/vi/vs_relative.c contrib/nvi/vi/vs_smap.c contrib/nvi/vi/vs_split.c contrib/nvi/regex/regcomp.c contrib/nvi/regex/regerror.c contrib/nvi/regex/regexec.c contrib/nvi/regex/regfree.c :: -Iusr.bin/vi -Icontrib/nvi -Icontrib/nvi/regex -Iusr.bin/vi/ex -D__REGEX_PRIVATE -DUSE_WIDECHAR -DHAVE_NCURSES_H -DHAVE_TERM_H -DHAVE_DIRENT_D_NAMLEN -D_XOPEN_SOURCE_EXTENDED=1 -I${PORTDIR}/../ncurses/${ARCH_WORK}/ncurses-6.5/include -include unistd.h -L${PORTDIR}/../ncurses/${ARCH_STAGE} -lncursesw

[prepare]
ln -sfn ${MACHINE}/include ${SRCDIR}/sys/machine
ln -sfn sys/x86/include ${SRCDIR}/x86
# Create ncurses.h symlink for nvi (ncurses builds curses.h, not ncurses.h)
NCURSES_INC=${PORTDIR}/../ncurses/${ARCH_WORK}/ncurses-6.5/include
if [ -f "$NCURSES_INC/curses.h" ] && [ ! -f "$NCURSES_INC/ncurses.h" ]; then
    ln -sfn curses.h "$NCURSES_INC/ncurses.h"
fi
# Generate awk grammar and proctab on host
cd ${SRCDIR}/contrib/one-true-awk
yacc -d awkgram.y
mv y.tab.h awkgram.tab.h
mv y.tab.c awkgram.tab.c
cc -o maketab maketab.c
./maketab awkgram.tab.h > proctab.c
# Generate m4 parser and tokenizer on host
cd ${SRCDIR}/usr.bin/m4
yacc -d -o parser.c parser.y
# Linux distributions typically ship `flex` without a `lex` symlink,
# while macOS provides BSD `lex` directly. Pick whichever exists.
LEX=$(command -v lex 2>/dev/null || command -v flex 2>/dev/null) || \
    { echo "error: neither lex nor flex is installed (need flex on Linux/WSL)" >&2; exit 1; }
"$LEX" -t tokenizer.l > tokenizer.c
# Generate libfetch error headers
cd ${SRCDIR}/lib/libfetch
awk 'BEGIN { print "static struct fetcherr ftp_errlist[] = {" } /^[0-9]/ { printf "\t{ %s, FETCH_%s, \"%s\" },\n", $1, $2, substr($0, index($0,$3)) } END { print "\t{ -1, FETCH_OK, \"\" }\n};" }' ftp.errors > ftperr.h
awk 'BEGIN { print "static struct fetcherr http_errlist[] = {" } /^[0-9]/ { printf "\t{ %s, FETCH_%s, \"%s\" },\n", $1, $2, substr($0, index($0,$3)) } END { print "\t{ -1, FETCH_OK, \"\" }\n};" }' http.errors > httperr.h
cp ${PORTDIR}/files/openpam/config.saltyos.h ${SRCDIR}/config.h
mkdir -p ${SRCDIR}/saltyos-files/etc/pam.d
cp ${PORTDIR}/files/openpam/pam.d/login ${SRCDIR}/saltyos-files/etc/pam.d/login
cp ${PORTDIR}/files/openpam/pam.d/su ${SRCDIR}/saltyos-files/etc/pam.d/su
cp ${PORTDIR}/files/openpam/pam.d/sudo ${SRCDIR}/saltyos-files/etc/pam.d/sudo
cp ${PORTDIR}/files/openpam/pam.d/system ${SRCDIR}/saltyos-files/etc/pam.d/system
cp ${PORTDIR}/files/openpam/pam.d/other ${SRCDIR}/saltyos-files/etc/pam.d/other
cp ${PORTDIR}/files/openpam/ttys ${SRCDIR}/saltyos-files/etc/ttys

[install]
bin/echo = _build/echo
bin/cat = _build/cat
bin/ls = _build/ls
bin/cp = _build/cp
bin/mv = _build/mv
bin/rm = _build/rm
bin/mkdir = _build/mkdir
bin/rmdir = _build/rmdir
bin/ln = _build/ln
bin/chmod = _build/chmod
bin/test = _build/test
bin/sleep = _build/sleep
bin/pwd = _build/pwd
usr/bin/head = _build/head
usr/bin/tail = _build/tail
usr/bin/wc = _build/wc
usr/bin/sort = _build/sort
usr/bin/uniq = _build/uniq
usr/bin/basename = _build/basename
usr/bin/dirname = _build/dirname
usr/bin/env = _build/env
usr/bin/tee = _build/tee
usr/bin/id = _build/id
usr/bin/uname = _build/uname
usr/bin/true = _build/true
usr/bin/false = _build/false
usr/bin/grep = _build/grep
usr/bin/find = _build/find
usr/bin/xargs = _build/xargs
bin/kill = _build/kill
bin/date = _build/date
usr/bin/touch = _build/touch
usr/bin/tr = _build/tr
usr/bin/cut = _build/cut
usr/bin/stat = _build/stat
# stat dispatches on argv[0]: behaves as readlink when called as readlink
