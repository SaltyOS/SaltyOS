[port]
name = wget
version = 1.24.5
description = GNU network file retrieval tool
homepage = https://www.gnu.org/software/wget/
license = GPL-3.0

[source]
url = https://ftp.gnu.org/gnu/wget/wget-${version}.tar.gz
subdir = wget-${version}
sha256 = fa2dc35bab5184ecbc46a9ef83def2aaaa3f4c9f3c97d4bd19dcb07d4da637de

[depends]
build = openssl, zlib

[build]
type = autotools
configure =
    -C
    --with-ssl=openssl
    --disable-ipv6
    --disable-nls
    --disable-pcre2
    --disable-pcre
    --without-metalink
    --without-cares
    --disable-iri
    --without-libidn2
    --without-libpsl
    --without-libuuid
    --without-libgnutls-prefix

[env]
CFLAGS_FOR_BUILD =
OPENSSL_CFLAGS = -I${PORTDIR}/../openssl/${ARCH_WORK}/openssl-3.4.1/include
OPENSSL_LIBS = -L${PORTDIR}/../openssl/${ARCH_WORK}/openssl-3.4.1 -L${PORTDIR}/../openssl/${ARCH_STAGE} -lssl -lcrypto
EXTRA_CFLAGS = -I${PORTDIR}/../openssl/${ARCH_WORK}/openssl-3.4.1/include -I${PORTDIR}/../zlib/${ARCH_WORK}/zlib-1.3.1 -I${PORTDIR}/../zlib/${ARCH_WORK}/zlib-1.3.1/_build
EXTRA_LDFLAGS = -L${PORTDIR}/../openssl/${ARCH_WORK}/openssl-3.4.1 -L${PORTDIR}/../openssl/${ARCH_STAGE} -L${PORTDIR}/../zlib/${ARCH_STAGE}
EXTRA_LIBS = -lssl -lcrypto -lz

[autoconf_cache]
ac_cv_func_getaddrinfo = yes
ac_cv_func_gethostbyname = yes
ac_cv_func___fpurge = yes
ac_cv_have_decl___fpurge = yes
ac_cv_func___freading = yes
ac_cv_have_decl___freading = yes
gl_cv_onwards_func___fpurge = yes

[install]
bin/wget = src/wget
