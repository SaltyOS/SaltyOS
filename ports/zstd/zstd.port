[port]
name = zstd
version = 1.5.6
description = Zstandard fast compression library
homepage = https://facebook.github.io/zstd/
license = BSD-3-Clause

[source]
url = https://github.com/facebook/zstd/releases/download/v${version}/zstd-${version}.tar.gz
subdir = zstd-${version}
sha256 = 8c29e06cf42aacc1eafc4077ae2ec6c6fcb96a626157e0593d5e82a34fd403c1

[build]
type = cmake
configure =
    -DCMAKE_SYSTEM_NAME=SaltyOS
    -DCMAKE_CROSSCOMPILING=TRUE
    -DCMAKE_SYSTEM_PROCESSOR=${ARCH}
    -DCMAKE_MODULE_PATH=${REPOROOT}/tools/cmake
    -DCMAKE_AR=${TOOLCHAIN_PREFIX}/bin/llvm-ar
    -DCMAKE_RANLIB=${TOOLCHAIN_PREFIX}/bin/llvm-ranlib
    -DBUILD_SHARED_LIBS=OFF
    -DZSTD_BUILD_PROGRAMS=OFF
    -DZSTD_BUILD_TESTS=OFF
    -DZSTD_BUILD_CONTRIB=OFF
    -DZSTD_BUILD_STATIC=ON
    -DZSTD_BUILD_SHARED=OFF

[prepare]
cat > ${SRCDIR}/CMakeLists.txt << 'ZSTDEOF'
cmake_minimum_required(VERSION 3.5)
project(zstd_wrapper C CXX)
add_subdirectory(build/cmake)
ZSTDEOF

[env]
EXTRA_CFLAGS = -DZSTD_NO_UNUSED_FUNCTIONS

[install]
libzstd.a = _build/build/cmake/lib/libzstd.a
