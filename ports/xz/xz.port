[port]
name = xz
version = 5.6.3
description = XZ Utils (liblzma) compression library
homepage = https://tukaani.org/xz/
license = Public Domain

[source]
url = https://github.com/tukaani-project/xz/releases/download/v${version}/xz-${version}.tar.gz
subdir = xz-${version}
sha256 = b1d45295d3f71f25a4c9101bd7c8d16cb56348bbef3bbc738da0351e17c73317

[build]
type = cmake
configure =
    -DCMAKE_SYSTEM_NAME=SaltyOS
    -DCMAKE_CROSSCOMPILING=TRUE
    -DCMAKE_SYSTEM_PROCESSOR=${ARCH}
    -DCMAKE_MODULE_PATH=${REPOROOT}/tools/cmake
    -DCMAKE_AR=${TOOLCHAIN_PREFIX}/bin/llvm-ar
    -DCMAKE_RANLIB=${TOOLCHAIN_PREFIX}/bin/llvm-ranlib
    -DBUILD_SHARED_LIBS=OFF
    -DBUILD_TESTING=OFF
    -DCREATE_XZ_SYMLINKS=OFF
    -DCREATE_LZMA_SYMLINKS=OFF
    -DENABLE_NLS=OFF

[stage]
mode = make-install

[stage.exclude]
usr/share/man
usr/share/doc
