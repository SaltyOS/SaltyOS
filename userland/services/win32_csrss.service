[Service]
Name=win32_csrss
Binary=/bin/win32_csrss
Type=notify
Restart=always

[Dependencies]
After=console namesrv vfs procmgr
Before=

[Capabilities]
# System roles via trona::caps::* — all four (namesrv, console, vfs, procmgr)
# are populated by procmgr's populate_cap_table for every post-procmgr child.
Require=namesrv
Require=console
Require=vfs
Require=procmgr
