[Service]
Name=dispdrv
Binary=/bin/dispdrv
Type=notify
Restart=no

[Dependencies]
After=console namesrv procmgr saltyfs vfs

[Capabilities]
# Cap-table delivery (option 5): system roles via trona::caps::*.
# No service-local Require= (dispdrv has no cross-service dependencies beyond system roles).
Require=namesrv
Require=mmsrv
Require=fb_untyped
