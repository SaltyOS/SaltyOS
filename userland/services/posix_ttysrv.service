[Service]
Name=posix_ttysrv
Binary=/bin/posix_ttysrv
Type=notify
Restart=always

[Dependencies]
After=console namesrv rsrcsrv procmgr vfs saltyfs dispdrv
Before=posix_getty

[Capabilities]
# CopyCap=138:66 delivers the VFS notification cap into child slot 66 via
# the spawner-private CopyCap mechanism (referenced as `CAP_VFS_NTFN` in
# src/types.rs). System + service-local roles flow through the cap_table.
CopyCap=138:66
Require=procmgr
Require=namesrv
Require=mmsrv
Require=dispdrv:dispdrv_ep
