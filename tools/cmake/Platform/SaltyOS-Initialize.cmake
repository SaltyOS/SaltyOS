# SaltyOS CMake platform initialisation
# SPDX-License-Identifier: GPL-2.0-only
#
# Loaded by CMake before compiler detection when CMAKE_SYSTEM_NAME=SaltyOS.
# Sets UNIX=1 so that LLVM (HandleLLVMOptions.cmake) and other CMake modules
# treat SaltyOS as a UNIX-like ELF platform.

set(SALTYOS 1)
set(UNIX 1)
