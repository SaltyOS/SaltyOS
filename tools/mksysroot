#!/usr/bin/env python3
"""
SaltyOS Sysroot Generator
SPDX-License-Identifier: GPL-2.0-only

Collects build outputs into a sysroot directory for cross-compilation.

Usage:
    tools/mksysroot --build-dir build --output sysroot
    tools/mksysroot --build-dir build --output sysroot --clean -v
"""

import argparse
import shutil
import sys
from pathlib import Path


# Required files: (sysroot destination relative to usr/lib, source relative to build-dir)
REQUIRED_BUILD_FILES = [
    ("libc.so",              "lib/besalt/c/libc.so"),
    ("libbesalt.so",         "lib/besalt/lib/libbesalt.so"),
    ("crt_start.o",          "lib/besalt/c/crt_start.o"),
    ("core.o",               "rust/core.o"),
    ("compiler_builtins.o",  "rust/compiler_builtins.o"),
    ("ld-besalt.so",         "userland/core/rtld/ld-besalt.so"),
]

# Optional files: copied if present, warned if missing
OPTIONAL_BUILD_FILES = [
    ("libbesalt.rmeta", "lib/besalt/lib/libbesalt.rmeta"),
    ("besaltc.rmeta",   "lib/besalt/c/besaltc.rmeta"),
]


def copy_file(src, dst, verbose):
    """Copy a single file, creating parent directories as needed."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
    if verbose:
        print(f"  {src} -> {dst}")


def main():
    parser = argparse.ArgumentParser(
        description="Collect SaltyOS build outputs into a cross-compilation sysroot"
    )
    parser.add_argument(
        "--build-dir",
        type=Path,
        required=True,
        help="Meson build directory (e.g. build)",
    )
    parser.add_argument(
        "--output",
        type=Path,
        required=True,
        help="Output sysroot directory",
    )
    parser.add_argument(
        "--clean",
        action="store_true",
        help="Remove output directory before populating",
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Print each file copied",
    )
    parser.add_argument(
        "--stamp",
        type=Path,
        help="Touch this file on success (for Meson output tracking)",
    )

    args = parser.parse_args()

    # Determine repo root from script location (tools/mksysroot -> repo root)
    repo_root = Path(__file__).resolve().parent.parent
    build_dir = args.build_dir.resolve()
    output_dir = args.output.resolve()

    header_src = repo_root / "lib" / "besalt" / "c" / "include"
    pie_linker_script = repo_root / "userland" / "tests" / "hello" / "link.ld"

    # Validate sources exist
    if not build_dir.is_dir():
        print(f"Error: build directory does not exist: {build_dir}", file=sys.stderr)
        sys.exit(1)
    if not header_src.is_dir():
        print(f"Error: header directory does not exist: {header_src}", file=sys.stderr)
        sys.exit(1)

    # Clean output if requested
    if args.clean and output_dir.exists():
        if args.verbose:
            print(f"Cleaning {output_dir}")
        shutil.rmtree(output_dir)

    # Create sysroot layout
    include_dir = output_dir / "usr" / "include"
    lib_dir = output_dir / "usr" / "lib"
    include_dir.mkdir(parents=True, exist_ok=True)
    lib_dir.mkdir(parents=True, exist_ok=True)

    copied = 0
    warnings = 0

    # Copy headers (preserve directory structure)
    if args.verbose:
        print(f"Copying headers from {header_src}")
    shutil.copytree(header_src, include_dir, dirs_exist_ok=True)
    header_count = sum(1 for _ in include_dir.rglob("*.h"))
    copied += header_count

    # Copy required build files
    for dest_name, src_rel in REQUIRED_BUILD_FILES:
        src = build_dir / src_rel
        dst = lib_dir / dest_name
        if not src.exists():
            print(f"Error: required file not found: {src}", file=sys.stderr)
            sys.exit(1)
        copy_file(src, dst, args.verbose)
        copied += 1

    # Copy PIE linker script from repo source
    if not pie_linker_script.exists():
        print(
            f"Error: PIE linker script not found: {pie_linker_script}",
            file=sys.stderr,
        )
        sys.exit(1)
    copy_file(pie_linker_script, lib_dir / "saltyos-pie.ld", args.verbose)
    copied += 1

    # Copy optional files
    for dest_name, src_rel in OPTIONAL_BUILD_FILES:
        src = build_dir / src_rel
        dst = lib_dir / dest_name
        if src.exists():
            copy_file(src, dst, args.verbose)
            copied += 1
        else:
            print(f"Warning: optional file not found, skipping: {src}")
            warnings += 1

    # Summary
    print(
        f"Sysroot created: {output_dir} "
        f"({copied} files copied, {header_count} headers, {warnings} warnings)"
    )

    # Touch stamp file for Meson dependency tracking
    if args.stamp:
        args.stamp.parent.mkdir(parents=True, exist_ok=True)
        args.stamp.touch()


if __name__ == "__main__":
    main()
