#!/usr/bin/env python3
"""
SaltyOS Sysroot Generator
SPDX-License-Identifier: GPL-2.0-only

Collects build outputs into a sysroot directory for cross-compilation.

Usage:
    tools/mksysroot --build-dir build --output sysroot
    tools/mksysroot --build-dir build --output sysroot --clean -v
"""

import argparse
import hashlib
import os
import shutil
import sys
import time
from pathlib import Path


# Required files: (sysroot destination relative to usr/lib, source relative to build-dir)
REQUIRED_BUILD_FILES = [
    ("libc.so",              "lib/basalt/c/libc.so"),
    ("libc.a",               "lib/basalt/c/libc.a"),
    ("libtrona.so",          "lib/trona/libtrona.so"),
    ("libtrona.a",           "lib/trona/libtrona.a"),
    ("crt_start.o",          "lib/basalt/c/crt_start.o"),
    ("core.o",               "lib/trona/core-trona.o"),
    ("compiler_builtins.o",  "lib/trona/compiler_builtins-trona.o"),
    ("ldtrona-elf.so",       "lib/trona/loader/ldtrona-elf.so"),
]

# Optional files: copied if present, warned if missing
OPTIONAL_BUILD_FILES = [
    ("ldtrona-pe.so",   "lib/trona/loader/ldtrona-pe.so"),
    ("trona.rmeta",     "lib/trona/trona.rmeta"),
    ("basaltc.rmeta",   "lib/basalt/c/basaltc.rmeta"),
    ("libc++.so",       "lib/basalt/cpp/libc++.so"),
]


# Collected list of all file paths mksysroot installs in this run. Used to
# write __base__ provenance without sweeping the whole sysroot (which would
# otherwise claim port-overlaid files as base-owned and break subsequent
# port overlays).
INSTALLED_PATHS: list = []


def _record(dst):
    INSTALLED_PATHS.append(Path(dst))


def copy_file(src, dst, verbose):
    """Copy a single file, creating parent directories as needed."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
    _record(dst)
    if verbose:
        print(f"  {src} -> {dst}")


def copy_if_changed(src, dst, verbose):
    """Copy only if content differs (compare size + mtime)."""
    if dst.exists():
        src_stat = src.stat()
        dst_stat = dst.stat()
        if src_stat.st_size == dst_stat.st_size and src_stat.st_mtime <= dst_stat.st_mtime:
            _record(dst)
            return False
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
    _record(dst)
    if verbose:
        print(f"  {src} -> {dst}")
    return True



def main():
    parser = argparse.ArgumentParser(
        description="Collect SaltyOS build outputs into a cross-compilation sysroot"
    )
    parser.add_argument(
        "--build-dir",
        type=Path,
        required=True,
        help="Meson build directory (e.g. build)",
    )
    parser.add_argument(
        "--output",
        type=Path,
        required=True,
        help="Output sysroot directory",
    )
    parser.add_argument(
        "--clean",
        action="store_true",
        help="Remove output directory before populating",
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Print each file copied",
    )
    parser.add_argument(
        "--stamp",
        type=Path,
        help="Touch this file on success (for Meson output tracking)",
    )

    args = parser.parse_args()

    # Determine repo root from script location (tools/mksysroot -> repo root)
    repo_root = Path(__file__).resolve().parent.parent
    build_dir = args.build_dir.resolve()
    output_dir = args.output.resolve()

    header_src = repo_root / "lib" / "basalt" / "c" / "include"
    pie_linker_script = repo_root / "lib" / "trona" / "trona-pie.ld"
    static_pie_linker_script = repo_root / "lib" / "trona" / "trona-static-pie.ld"
    cxx_inc_src = repo_root / "toolchain" / "llvm-project" / "libcxx" / "include"
    cxxabi_inc_src = repo_root / "toolchain" / "llvm-project" / "libcxxabi" / "include"
    cxx_config_site = repo_root / "lib" / "basalt" / "cpp" / "__config_site"
    cxx_assertion_handler = repo_root / "lib" / "basalt" / "cpp" / "__assertion_handler"

    # Validate sources exist
    if not build_dir.is_dir():
        print(f"Error: build directory does not exist: {build_dir}", file=sys.stderr)
        sys.exit(1)
    if not header_src.is_dir():
        print(f"Error: header directory does not exist: {header_src}", file=sys.stderr)
        sys.exit(1)

    # Clean output if requested
    if args.clean and output_dir.exists():
        if args.verbose:
            print(f"Cleaning {output_dir}")
        shutil.rmtree(output_dir)

    # Create sysroot layout
    include_dir = output_dir / "usr" / "include"
    lib_dir = output_dir / "usr" / "lib"
    include_dir.mkdir(parents=True, exist_ok=True)
    lib_dir.mkdir(parents=True, exist_ok=True)

    # Select copy function: incremental when not cleaning, full when cleaning
    do_copy = copy_file if args.clean else copy_if_changed

    copied = 0
    skipped = 0
    warnings = 0

    # Copy C headers (preserve directory structure). We enumerate source
    # files so we only record the headers basaltc actually provides; a plain
    # `include_dir.rglob` after copytree would also sweep up headers that
    # ports previously overlaid into the same tree (e.g. ncurses's curses.h)
    # and mis-claim them as base-owned.
    if args.verbose:
        print(f"Copying C headers from {header_src}")
    shutil.copytree(header_src, include_dir, dirs_exist_ok=True)
    header_count = 0
    for src_h in header_src.rglob("*"):
        if src_h.is_file():
            rel = src_h.relative_to(header_src)
            _record(include_dir / rel)
            if src_h.suffix == ".h":
                header_count += 1
    copied += header_count

    # Copy C++ headers (libcxx + libcxxabi) into usr/include/c++/v1/ when available.
    # Same caveat as the C header pass: enumerate the sources (not the destination
    # tree) when recording provenance so we don't reclaim port-overlaid files.
    cxx_inc_dst = output_dir / "usr" / "include" / "c++" / "v1"
    if cxx_inc_src.is_dir():
        if args.verbose:
            print(f"Copying C++ headers from {cxx_inc_src}")
        shutil.copytree(cxx_inc_src, cxx_inc_dst, dirs_exist_ok=True)
        for src_h in cxx_inc_src.rglob("*"):
            if src_h.is_file():
                _record(cxx_inc_dst / src_h.relative_to(cxx_inc_src))
        if cxxabi_inc_src.is_dir():
            shutil.copytree(cxxabi_inc_src, cxx_inc_dst, dirs_exist_ok=True)
            for src_h in cxxabi_inc_src.rglob("*"):
                if src_h.is_file():
                    _record(cxx_inc_dst / src_h.relative_to(cxxabi_inc_src))
        if cxx_config_site.exists():
            copy_file(cxx_config_site, cxx_inc_dst / "__config_site", args.verbose)
        if cxx_assertion_handler.exists():
            copy_file(cxx_assertion_handler, cxx_inc_dst / "__assertion_handler", args.verbose)
        cxx_header_count = sum(1 for _ in cxx_inc_dst.rglob("*") if _.is_file())
        copied += cxx_header_count
        if args.verbose:
            print(f"  {cxx_header_count} C++ headers installed to {cxx_inc_dst}")
    elif args.verbose:
        print(f"  Skipping C++ headers (toolchain/llvm-project not found)")

    # Copy required build files
    for dest_name, src_rel in REQUIRED_BUILD_FILES:
        src = build_dir / src_rel
        dst = lib_dir / dest_name
        if not src.exists():
            print(f"Error: required file not found: {src}", file=sys.stderr)
            sys.exit(1)
        if do_copy(src, dst, args.verbose) is not False:
            copied += 1
        else:
            skipped += 1

    # Copy PIE linker script from repo source
    if not pie_linker_script.exists():
        print(
            f"Error: PIE linker script not found: {pie_linker_script}",
            file=sys.stderr,
        )
        sys.exit(1)
    if do_copy(pie_linker_script, lib_dir / "trona-pie.ld", args.verbose) is not False:
        copied += 1
    else:
        skipped += 1
    if not static_pie_linker_script.exists():
        print(
            f"Error: static PIE linker script not found: {static_pie_linker_script}",
            file=sys.stderr,
        )
        sys.exit(1)
    if do_copy(static_pie_linker_script, lib_dir / "trona-static-pie.ld", args.verbose) is not False:
        copied += 1
    else:
        skipped += 1

    # Copy optional files
    for dest_name, src_rel in OPTIONAL_BUILD_FILES:
        src = build_dir / src_rel
        dst = lib_dir / dest_name
        if src.exists():
            if do_copy(src, dst, args.verbose) is not False:
                copied += 1
            else:
                skipped += 1
        else:
            print(f"Warning: optional file not found, skipping: {src}")
            warnings += 1

    # Create empty stub archives (musl-libc pattern).
    # SaltyOS folds math, pthread, rt, dl, and util into libc.so.
    # Build systems that unconditionally pass -lm/-lpthread/-lrt/-ldl/-lutil
    # need these files to exist; the linker finds them, sees no objects, and
    # is satisfied — actual symbols come from libc.so already on the link line.
    stub_libs = ["libm.a", "libpthread.a", "librt.a", "libdl.a", "libutil.a"]
    for name in stub_libs:
        path = lib_dir / name
        with open(path, "wb") as f:
            f.write(b"!<arch>\n")
        _record(path)
        if args.verbose:
            print(f"Created stub archive: {path}")
        copied += 1

    # Record __base__ provenance so port overlay can detect collisions
    # against mksysroot-owned files. Format matches tools/port/overlay.rs:
    #   F\tmode(oct)\tsha256\tpath
    #   L\tmode(oct)\t-\tpath\ttarget
    provenance_dir = output_dir / ".port-provenance"
    provenance_dir.mkdir(parents=True, exist_ok=True)
    base_files = provenance_dir / "__base__.files"
    base_meta = provenance_dir / "__base__.meta"

    def sha256_hex(path: Path) -> str:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(65536), b""):
                h.update(chunk)
        return h.hexdigest()

    lines = [
        "# SaltyOS port provenance — do not edit by hand",
        "# format: F\\tmode(oct)\\tsha256\\tpath  |  L\\tmode(oct)\\t-\\tpath\\ttarget",
    ]
    # Record only the files this mksysroot run actually installed. Do NOT
    # rglob the whole sysroot — that would re-claim files previously overlaid
    # by ports as __base__, causing subsequent port overlays to fail with
    # "file X also owned by __base__".
    seen_rels = set()
    for p in sorted(INSTALLED_PATHS):
        try:
            st = p.lstat()
        except OSError:
            continue
        try:
            rel = p.resolve().relative_to(output_dir.resolve()).as_posix()
        except ValueError:
            continue
        if rel in seen_rels:
            continue
        seen_rels.add(rel)
        mode_oct = oct(st.st_mode & 0o7777)[2:]
        if p.is_symlink():
            target = os.readlink(p)
            lines.append(f"L\t{mode_oct}\t-\t{rel}\t{target}")
        elif p.is_file():
            lines.append(f"F\t{mode_oct}\t{sha256_hex(p)}\t{rel}")
    base_files.write_text("\n".join(lines) + "\n")
    base_meta.write_text(
        f"name = base\nversion = \nstamp = \noverlaid_at = {int(time.time())}\n"
    )

    # Summary
    parts = [f"{copied} files copied", f"{header_count} headers"]
    if skipped:
        parts.append(f"{skipped} unchanged")
    if warnings:
        parts.append(f"{warnings} warnings")
    print(f"Sysroot {'created' if args.clean else 'updated'}: {output_dir} ({', '.join(parts)})")

    # Touch stamp file for Meson dependency tracking
    if args.stamp:
        args.stamp.parent.mkdir(parents=True, exist_ok=True)
        args.stamp.touch()


if __name__ == "__main__":
    main()
