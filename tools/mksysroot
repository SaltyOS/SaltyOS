#!/usr/bin/env python3
"""
SaltyOS Sysroot Generator
SPDX-License-Identifier: GPL-2.0-only

Collects build outputs into a sysroot directory for cross-compilation.

Usage:
    tools/mksysroot --build-dir build --output sysroot
    tools/mksysroot --build-dir build --output sysroot --clean -v
"""

import argparse
import shutil
import sys
from pathlib import Path


# Required files: (sysroot destination relative to usr/lib, source relative to build-dir)
REQUIRED_BUILD_FILES = [
    ("libc.so",              "lib/basalt/c/libc.so"),
    ("libtrona.so",          "lib/trona/libtrona.so"),
    ("crt_start.o",          "lib/basalt/c/crt_start.o"),
    ("core.o",               "rust/core.o"),
    ("compiler_builtins.o",  "rust/compiler_builtins.o"),
    ("ld-trona.so",          "lib/trona/rtld/ld-trona.so"),
]

# Optional files: copied if present, warned if missing
OPTIONAL_BUILD_FILES = [
    ("trona.rmeta",     "lib/trona/trona.rmeta"),
    ("basaltc.rmeta",   "lib/basalt/c/basaltc.rmeta"),
    ("libc++.so",       "lib/basalt/cpp/libc++.so"),
]


def copy_file(src, dst, verbose):
    """Copy a single file, creating parent directories as needed."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
    if verbose:
        print(f"  {src} -> {dst}")



def main():
    parser = argparse.ArgumentParser(
        description="Collect SaltyOS build outputs into a cross-compilation sysroot"
    )
    parser.add_argument(
        "--build-dir",
        type=Path,
        required=True,
        help="Meson build directory (e.g. build)",
    )
    parser.add_argument(
        "--output",
        type=Path,
        required=True,
        help="Output sysroot directory",
    )
    parser.add_argument(
        "--clean",
        action="store_true",
        help="Remove output directory before populating",
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Print each file copied",
    )
    parser.add_argument(
        "--stamp",
        type=Path,
        help="Touch this file on success (for Meson output tracking)",
    )

    args = parser.parse_args()

    # Determine repo root from script location (tools/mksysroot -> repo root)
    repo_root = Path(__file__).resolve().parent.parent
    build_dir = args.build_dir.resolve()
    output_dir = args.output.resolve()

    header_src = repo_root / "lib" / "basalt" / "c" / "include"
    pie_linker_script = repo_root / "lib" / "trona" / "trona-pie.ld"
    cxx_inc_src = repo_root / "toolchain" / "llvm-project" / "libcxx" / "include"
    cxxabi_inc_src = repo_root / "toolchain" / "llvm-project" / "libcxxabi" / "include"
    cxx_config_site = repo_root / "lib" / "basalt" / "cpp" / "__config_site"
    cxx_assertion_handler = repo_root / "lib" / "basalt" / "cpp" / "__assertion_handler"

    # Validate sources exist
    if not build_dir.is_dir():
        print(f"Error: build directory does not exist: {build_dir}", file=sys.stderr)
        sys.exit(1)
    if not header_src.is_dir():
        print(f"Error: header directory does not exist: {header_src}", file=sys.stderr)
        sys.exit(1)

    # Clean output if requested
    if args.clean and output_dir.exists():
        if args.verbose:
            print(f"Cleaning {output_dir}")
        shutil.rmtree(output_dir)

    # Create sysroot layout
    include_dir = output_dir / "usr" / "include"
    lib_dir = output_dir / "usr" / "lib"
    include_dir.mkdir(parents=True, exist_ok=True)
    lib_dir.mkdir(parents=True, exist_ok=True)

    copied = 0
    warnings = 0

    # Copy C headers (preserve directory structure)
    if args.verbose:
        print(f"Copying C headers from {header_src}")
    shutil.copytree(header_src, include_dir, dirs_exist_ok=True)
    header_count = sum(1 for _ in include_dir.rglob("*.h"))
    copied += header_count

    # Copy C++ headers (libcxx + libcxxabi) into usr/include/c++/v1/ when available
    cxx_inc_dst = output_dir / "usr" / "include" / "c++" / "v1"
    if cxx_inc_src.is_dir():
        if args.verbose:
            print(f"Copying C++ headers from {cxx_inc_src}")
        shutil.copytree(cxx_inc_src, cxx_inc_dst, dirs_exist_ok=True)
        if cxxabi_inc_src.is_dir():
            shutil.copytree(cxxabi_inc_src, cxx_inc_dst, dirs_exist_ok=True)
        if cxx_config_site.exists():
            copy_file(cxx_config_site, cxx_inc_dst / "__config_site", args.verbose)
        if cxx_assertion_handler.exists():
            copy_file(cxx_assertion_handler, cxx_inc_dst / "__assertion_handler", args.verbose)
        cxx_header_count = sum(1 for _ in cxx_inc_dst.rglob("*") if _.is_file())
        copied += cxx_header_count
        if args.verbose:
            print(f"  {cxx_header_count} C++ headers installed to {cxx_inc_dst}")
    elif args.verbose:
        print(f"  Skipping C++ headers (toolchain/llvm-project not found)")

    # Copy required build files
    for dest_name, src_rel in REQUIRED_BUILD_FILES:
        src = build_dir / src_rel
        dst = lib_dir / dest_name
        if not src.exists():
            print(f"Error: required file not found: {src}", file=sys.stderr)
            sys.exit(1)
        copy_file(src, dst, args.verbose)
        copied += 1

    # Copy PIE linker script from repo source
    if not pie_linker_script.exists():
        print(
            f"Error: PIE linker script not found: {pie_linker_script}",
            file=sys.stderr,
        )
        sys.exit(1)
    copy_file(pie_linker_script, lib_dir / "trona-pie.ld", args.verbose)
    copied += 1

    # Copy optional files
    for dest_name, src_rel in OPTIONAL_BUILD_FILES:
        src = build_dir / src_rel
        dst = lib_dir / dest_name
        if src.exists():
            copy_file(src, dst, args.verbose)
            copied += 1
        else:
            print(f"Warning: optional file not found, skipping: {src}")
            warnings += 1

    # Create empty stub archives (musl-libc pattern).
    # SaltyOS folds math, pthread, rt, dl, and util into libc.so.
    # Build systems that unconditionally pass -lm/-lpthread/-lrt/-ldl/-lutil
    # need these files to exist; the linker finds them, sees no objects, and
    # is satisfied — actual symbols come from libc.so already on the link line.
    stub_libs = ["libm.a", "libpthread.a", "librt.a", "libdl.a", "libutil.a"]
    for name in stub_libs:
        path = lib_dir / name
        with open(path, "wb") as f:
            f.write(b"!<arch>\n")
        if args.verbose:
            print(f"Created stub archive: {path}")
        copied += 1

    # Summary
    print(
        f"Sysroot created: {output_dir} "
        f"({copied} files copied, {header_count} headers, {warnings} warnings)"
    )

    # Touch stamp file for Meson dependency tracking
    if args.stamp:
        args.stamp.parent.mkdir(parents=True, exist_ok=True)
        args.stamp.touch()


if __name__ == "__main__":
    main()
