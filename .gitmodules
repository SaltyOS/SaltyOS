[submodule "toolchain/llvm-project"]
	path = toolchain/llvm-project
	url = https://github.com/SaltyOS/llvm-project.git
[submodule "toolchain/rust"]
	path = toolchain/rust
	url = https://github.com/SaltyOS/rust.git
[submodule "lib/besalt"]
	path = lib/besalt
	url = https://github.com/SaltyOS/besalt
	branch = vNext
[submodule "lib/rust-lang/libc"]
	path = lib/rust-lang/libc
	url = https://github.com/SaltyOS/rust-lang-libc.git
