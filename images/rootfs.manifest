# SaltyOS rootfs image — non-initrd binaries
# SPDX-License-Identifier: GPL-2.0-only
#
# Boot-critical services + .service files are in the initrd CPIO.
# Non-critical binaries are loaded from rootfs via VFS fallback.

/bin/display=build/display.stripped.elf
/bin/ttyd=build/ttyd.stripped.elf
/bin/getty=build/getty.stripped.elf
/bin/test_runner=build/test_runner.stripped.elf
/bin/hello=build/hello.stripped.elf
/bin/netdrv=build/netdrv.stripped.elf
/bin/netsrv=build/netsrv.stripped.elf
/bin/dnssrv=build/dnssrv.stripped.elf

@include llvm.manifest
